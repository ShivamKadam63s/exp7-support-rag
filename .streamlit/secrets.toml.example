# LOCAL USE: copy this file to ".streamlit/secrets.toml" and fill it in.
# STREAMLIT CLOUD: paste the same lines into  App -> Settings -> Secrets.
# NEVER commit the real secrets.toml (it is already in .gitignore).

LLM_API_KEY = "paste_your_groq_key_here"
LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_MODEL = "openai/gpt-oss-20b"

# Optional protection, so strangers cannot use up your free quota:
# APP_PASSCODE = "choose_a_passcode"
# MAX_QUESTIONS_PER_SESSION = "30"
